FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/topas
ENV G4=$HOME/Applications/GEANT4

# --- System dependencies (no recommends, git instead of git-all, clean lists)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libexpat1-dev libgl1-mesa-dev libglu1-mesa-dev libxt-dev xorg-dev \
        build-essential libharfbuzz-dev cmake git wget ca-certificates \
        qt6-base-dev qt6-base-dev-tools qt6-tools-dev qt6-tools-dev-tools \
        libqt6opengl6-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Geant4: download, build, install, delete source + build in ONE layer
WORKDIR $G4
RUN wget -q https://gitlab.cern.ch/geant4/geant4/-/archive/v11.3.2/geant4-v11.3.2.tar.gz \
    && tar -xzf geant4-v11.3.2.tar.gz \
    && mkdir geant4-build geant4-install \
    && cd geant4-build \
    && cmake ../geant4-v11.3.2 -DGEANT4_INSTALL_DATA=OFF -DGEANT4_BUILD_MULTITHREADED=ON \
         -DCMAKE_INSTALL_PREFIX=$G4/geant4-install -DCMAKE_PREFIX_PATH=/usr/lib/qt6 \
         -DGEANT4_USE_QT=ON -DGEANT4_USE_QT_QT6=ON \
    && make -j20 install \
    && cd .. && rm -rf geant4-build geant4-v11.3.2 geant4-v11.3.2.tar.gz

# --- Datasets: extract and delete each tarball immediately
WORKDIR $G4/G4DATA
RUN for f in G4NDL.4.7.1 G4EMLOW.8.6.1 G4PhotonEvaporation.6.1 G4RadioactiveDecay.6.1.2 \
             G4PARTICLEXS.4.1 G4ABLA.3.3 G4INCL.1.2 G4ENSDFSTATE.3.0 G4CHANNELING.1.0 \
             G4NUDEXLIB.1.0 G4URRPT.1.1 G4PII.1.3 G4RealSurface.2.2 G4SAIDDATA.2.0 \
             G4TENDL.1.4 ; do \
        wget -q https://cern.ch/geant4-data/datasets/$f.tar.gz \
        && tar -xzf $f.tar.gz && rm $f.tar.gz || exit 1 ; \
    done

ENV LD_LIBRARY_PATH=$G4/geant4-install/lib

WORKDIR $HOME/work
CMD ["bash"]
